# Known-good baseline for the launcher WITH network features on a 4MB
# classic ESP32 (WROOM). Layer it after sdkconfig.defaults[.esp32]:
#
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32;sdkconfig.4mb_net.defaults" \
#          set-target esp32
#
# then enable the remote-control transports and WiFi in menuconfig (or your
# own board fragment). This file only carries the size/memory relief that
# the 4MB classic ESP32 needs once NimBLE + WiFi + esp_http_server are in --
# without it the link fails ("iram0_0_seg overflowed") and the 2nd-stage
# bootloader runs out of its 28KB partition.
#
# 8MB S3 boards do NOT need this (partitions.csv already sizes factory for
# all-net, and the S3 has far more IRAM/heap headroom).

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb_net.csv"

# Build for size everywhere (default is -Og). Biggest single IRAM/flash win.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Move WiFi's speed-optimised paths and non-ISR FreeRTOS funcs out of IRAM
# into flash. ~17KB IRAM back. Throughput cost is irrelevant for a menu +
# a one-shot binary upload.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_SNAPSHOT_FUNS_INTO_FLASH=y

# 2nd-stage bootloader is near its 28KB limit with CONFIG_BOOTLOADER_FACTORY_RESET
# (crash-loop recovery) on -- drop its log strings.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# NimBLE host, BLE-only. NimBLE (not Bluedroid) is what net_remote_ble.c
# builds against; "select" can't pick a Bluetooth host from Kconfig.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
